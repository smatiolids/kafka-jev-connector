{
  "name": "jev-local",
  "config": {
    "connector.class": "io.github.smatiolids.kafkajev.JevSinkConnector",
    "tasks.max": "1",
    "topics": "jev-input",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "output.bootstrap.servers": "kafka:9092",
    "output.topic": "jev-output",
    "errors.deadletter.topic": "jev-dlq",
    "question.set.id": "support-routing/local-v1",
    "jev.api.key": "local-fake-jev-key",
    "jev.endpoint": "http://fake-jev:8080/v1/systemone",
    "jev.allow.insecure.http": true,
    "jev.model": "jev-test-1",
    "jev.questions": "{\"department\":{\"type\":\"choice\",\"instructions\":\"Which team should handle this?\",\"criteria\":{\"billing\":\"Payment issues\",\"technical\":\"Technical issues\",\"sales\":\"Sales questions\"}}}",
    "state.mode": "TEMPLATE",
    "state.template": "Customer message: ${value:/message}",
    "jev.max.in.flight": "4",
    "jev.connect.timeout.ms": "5000",
    "jev.request.timeout.ms": "10000",
    "jev.retry.max.attempts": "3",
    "jev.retry.initial.backoff.ms": "250",
    "jev.retry.max.retry_after.ms": "30000",
    "state.raw_bytes.encoding": "DISABLED",
    "state.max.bytes": "0",
    "output.key.mode": "ORIGINAL",
    "output.headers.mode": "NONE",
    "behavior.on.null.values": "IGNORE",
    "errors.transient.exhausted": "FAIL"
  }
}
